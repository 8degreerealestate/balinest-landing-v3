{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "dev": "pnpm -r --parallel --filter @workspace/api-server --filter @workspace/8degree run dev",
    "dev:api": "pnpm --filter @workspace/api-server run dev",
    "dev:web": "pnpm --filter @workspace/8degree run dev",
    "vercel:login": "npx vercel@latest login",
    "vercel:link": "npx vercel@latest link --scope matts-projects-cb3e7451",
    "vercel:deploy": "npx vercel@latest deploy --prod --scope matts-projects-cb3e7451 --yes",
    "db:push": "pnpm --filter @workspace/db run push",
    "db:check": "pnpm exec tsx scripts/check-database.ts",
    "crm:test": "pnpm --filter @workspace/scripts run crm:test",
    "seo:crawl": "pnpm --filter @workspace/scripts run seo:crawl",
    "seo:build": "pnpm --filter @workspace/scripts run seo:build",
    "seo:compare": "pnpm --filter @workspace/scripts run seo:compare",
    "journal:sync-media": "node scripts/sync-journal-media.mjs",
    "partner-landings:build": "node scripts/build-partner-landings.mjs",
    "build:production": "VITE_PUBLIC_SITE_URL=https://8degree.co pnpm --filter @workspace/8degree run build",
    "cutover:preflight": "pnpm seo:crawl && pnpm seo:build && pnpm seo:compare -- --staging=https://balinest-landing-v3.vercel.app",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"
  },
  "private": true,
  "devDependencies": {
    "typescript": "~5.9.2",
    "prettier": "^3.8.1"
  }
}
