# Postgres — use Supabase in production (Vercel + local dev).
# Supabase → Project Settings → Database → Connection string → URI.
# URL-encode special characters in the password (? → %3F, & → %26, etc.).
# For Vercel/serverless prefer **Transaction pooler** (port 6543), not direct :5432.
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
# Optional alias: SUPABASE_DATABASE_URL (same value as DATABASE_URL)
#
# Local-only fallback:
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/postgres

# Inventory: Google Sheets only (not WordPress). Default when PROPERTY_INVENTORY_SOURCE is unset or `sheet`.
# Built-in workbook/tab match 8D property list unless you override:
# PROPERTY_INVENTORY_SPREADSHEET_ID=1f8XO2oa7JpYP7XvfXX8iTZqTD_oc5rPXvONQrCNGP6U
# PROPERTY_INVENTORY_SHEET_GID=685479834
# Merge extra workbook tabs (silent, rentals, etc.): comma-separated gids; later tabs override duplicate codes
# PROPERTY_INVENTORY_SHEET_GIDS=685479834,1234567890
# Or full CSV export URL (https or local file):
# PROPERTY_INVENTORY_SHEET_EXPORT_URL=https://docs.google.com/spreadsheets/d/.../export?format=csv&gid=...
# PROPERTY_INVENTORY_SHEET_EXPORT_URL=file:///absolute/path/to/inventory-export.csv
# Sheet must be shared: Anyone with the link → Viewer (or Publish to web).
# Optional extra CSV tried after network URLs (absolute or relative to process cwd):
# PROPERTY_INVENTORY_FALLBACK_CSV=artifacts/api-server/data/dev-property-inventory-fallback.csv
# Shipped fallback CSV (artifacts/api-server/data/dev-property-inventory-fallback.csv) is tried after Google
# when NODE_ENV is not production/prod (includes unset NODE_ENV on ad-hoc local runs). Disable: PROPERTY_INVENTORY_SHIPPED_FALLBACK=0
# PROPERTY_INVENTORY_SOURCE=database   # force Postgres only (disables sheet + shipped CSV path for list)
# PROPERTY_INVENTORY_DRIVE_CONCURRENCY=6  # parallel Drive folder fetches on sheet load

# If port 8080 is already in use: set PORT for the API and match Vite’s proxy, e.g.
PORT=8080
# PORT=8090
# API_URL=http://localhost:8090
# VITE_STRICT_LOCAL=1
# VITE_API_BASE_URL=
# Production (required before 8degree.co cutover — canonicals, sitemap, OG):
# VITE_PUBLIC_SITE_URL=https://8degree.co

# --- Contact & WhatsApp (frontend build-time) ---
# Default public WhatsApp link (wa.link short URL)
# VITE_WHATSAPP_URL=https://wa.link/paxsz0
# E.164 digits only, no + (fallback when VITE_WHATSAPP_URL unset and a prefilled message is needed)
# VITE_WHATSAPP_NUMBER_E164=6287787169089
# VITE_CONTACT_EMAIL=hello@8degree.com
# VITE_CONTACT_PHONE_DISPLAY=+62 877 8716 9089
# If DISPLAY env digits differ from WHATSAPP E164, the app uses the WhatsApp number for display.

# --- Go High Level CRM (API server only — never expose token to the browser) ---
# Private Integration Token from GHL → Settings → Private Integrations.
# Required scopes: contacts.write (and locations.read if GOHIGHLEVEL_LOCATION_ID is unset).
# Test: pnpm run crm:test
# GOHIGHLEVEL_API_TOKEN=pit-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Sub-account location ID (GHL → Settings → Business Profile, or URL location id).
# Required if your token can access multiple locations; optional if exactly one sub-account.
# GOHIGHLEVEL_LOCATION_ID=ve9EPM428h8vShlRW1KT
# GOHIGHLEVEL_SYNC_ENABLED=1
# Set to 0 to disable CRM push while keeping enquiries in Postgres:
# GOHIGHLEVEL_SYNC_ENABLED=0

# --- Journal images (WordPress uploads mirror) ---
# Posts rewrite https://8degree.co/wp-content/uploads/... → /wp-content/uploads/... (same paths as WordPress).
# Before DNS cutover, those absolute URLs worked because 8degree.co still hosted WordPress.
# 1) Download once from Hostinger (hPanel → site → temporary/preview domain):
#    JOURNAL_MEDIA_SOURCE_BASE=https://xxxx.hostingersite.com pnpm journal:sync-media
#    Or from a local backup folder: JOURNAL_MEDIA_SOURCE_BASE=file:///path/to/site pnpm journal:sync-media
# 2) Commit artifacts/8degree/public/wp-content/uploads/ then deploy.
# 3) Or proxy missing files at runtime (Vercel → /api/journal-media/...):
# JOURNAL_MEDIA_SOURCE_BASE=https://your-old-site.hostingersite.com

# --- Journal import (from live https://8degree.co/journal/) ---
# Export: pnpm --filter @workspace/scripts run export-journal
# Import into Postgres (API must be running): pnpm --filter @workspace/scripts run import-journal-json
